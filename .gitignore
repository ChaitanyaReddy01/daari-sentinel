# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (all .env files except the committed example)
.env*
!.env.example

# perception-lab runtime data (upload/file-id cache, SAM result cache, cost ledger)
data/cache/
data/ledger.jsonl

# npm cache
.npm-cache/

# raw + prepped test fixtures stay local (upload via script, never commit)
clips/raw/
public/clips/prepped/synth-*

# self-recorded footage: commit ONLY the blurred version, never the original
clips/own/
public/clips/blurred/synth-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# throwaway verification screenshots
.verify-shots/
